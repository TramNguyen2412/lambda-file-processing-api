    "@types/pg": "^8.23.1",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1178.0",
    "@aws-sdk/client-secrets-manager": "^3.1178.0",
    "@aws-sdk/client-sns": "^3.1178.0",
    "@aws-sdk/client-sqs": "^3.1178.0",
    "@aws-sdk/s3-request-presigner": "^3.1178.0",
    "exceljs": "^4.4.0",
