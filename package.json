    "test:local": "node scripts/test-local.mjs",
    "test:phase2": "node scripts/test-phase2-local.mjs",
    "test:phase3": "node scripts/test-phase3-local.mjs",
    "test:phase4": "node scripts/test-phase4-local.mjs",
